{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "module": "preserve",
    "noEmit": true,
    "lib": ["es2022"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["main.ts", "src/**/*.ts"]
}
